# Optional fallback access token. You can now add/select tokens in the
# dashboard (stored encrypted in Redis); this .env value is only the default
# "Token mặc định (.env)" option. Leave blank to manage tokens entirely in UI.
FACEBOOK_ACCESS_TOKEN=
# Optional default ad account. The dashboard lists every ad account the active
# token can reach and lets you pick one; this is only the pre-selected fallback.
FACEBOOK_AD_ACCOUNT_ID=
FACEBOOK_API_VERSION=v23.0

# REQUIRED to add tokens via the dashboard. Master key used to encrypt stored
# access tokens at rest (AES-256-GCM). Generate with: openssl rand -base64 32
# Changing this value invalidates all previously stored tokens (re-add them).
TOKEN_ENCRYPTION_KEY=

REDIS_URL=redis://localhost:6379

UPLOAD_JOB_QUEUE_NAME=media-upload
# 7 days. Must exceed the longest expected drain — a dev-tier 5000-image
# batch takes ~21h and queued jobs sit untouched while waiting, so a shorter
# TTL would expire them mid-drain.
UPLOAD_JOB_TTL_SECONDS=604800
UPLOAD_JOB_ATTEMPTS=10
# Jobs processed in parallel within the one worker process. No longer tied to
# ad-account count — the per-account gate was removed in favor of a
# per-account Meta request throttle (see README "Pacing").
UPLOAD_WORKER_CONCURRENCY=4
UPLOAD_WORKER_RATE_LIMIT_MAX=1
UPLOAD_WORKER_RATE_LIMIT_DURATION_MS=1000
# Floor only between Meta requests per ad account. Tier-adaptive pacing
# (15s dev-tier / 200ms standard-tier) paces slower than this when the
# detected tier requires it; never faster.
UPLOAD_META_REQUEST_INTERVAL_MS=1000
# Fallback wait, used only when Meta's response carries no usage header to
# derive a wait from.
UPLOAD_META_RATE_LIMIT_DELAY_MS=300000
# OOM guard only — NOT Meta's documented image size limit (undocumented /
# unknown). Rejects a file before it is fully read into memory.
UPLOAD_MAX_FILE_BYTES=104857600
# Folder-mode batch cap. Explicit multi-file picks are separately capped at
# 500 (hardcoded, not env-configurable).
UPLOAD_MAX_BATCH_FILES=10000

WEBDAV_BASE_URL=https://nas-api.batmedia.info/
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
