{
  "name": "fb-media-uploader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup-local-env.mjs",
    "dev": "next dev",
    "dev:all": "concurrently --names web,worker --prefix-colors cyan,magenta --kill-others-on-fail \"npm:dev\" \"npm:worker:media\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "worker:media": "tsx --env-file-if-exists=.env workers/media-upload-worker.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "bullmq": "^5.79.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
